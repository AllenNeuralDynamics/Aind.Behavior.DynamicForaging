            <Expression xsi:type="Combinator">
              <Combinator xsi:type="p1:ManipulatorPosition">
                <p1:X>0</p1:X>
                <p1:Y1>0</p1:Y1>
                <p1:Y2>0</p1:Y2>
                <p1:Z>0</p1:Z>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:BehaviorSubject">
              <Name>ManipulatorPosition</Name>
            </Expression>
            <Expression xsi:type="Combinator">
