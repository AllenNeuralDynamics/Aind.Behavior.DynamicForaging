                          <Combinator xsi:type="rx:Merge" />
                        </Expression>
                        <Expression xsi:type="scr:ExpressionTransform">
                          <scr:Expression>new (
 it.Size.Width / 2 as X,
 it.Size.Height / 2 as Y
)</scr:Expression>
