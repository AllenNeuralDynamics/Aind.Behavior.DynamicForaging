            <Expression xsi:type="imgui:ButtonBuilder">
              <imgui:Name>ForwardLeft</imgui:Name>
              <imgui:Visible>true</imgui:Visible>
              <imgui:Text>Forward Left</imgui:Text>
            </Expression>
            <Expression xsi:type="imgui:ButtonBuilder">
              <imgui:Name>ForwardRight</imgui:Name>
              <imgui:Visible>true</imgui:Visible>
              <imgui:Text>Forward Right</imgui:Text>
            </Expression>
            <Expression xsi:type="imgui:ButtonBuilder">
              <imgui:Name>Up</imgui:Name>
              <imgui:Visible>true</imgui:Visible>
              <imgui:Text>Up</imgui:Text>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:CombineLatest" />
            </Expression>
            <Expression xsi:type="imgui:TableNextColumnBuilder">
              <imgui:Visible>true</imgui:Visible>
            </Expression>
            <Expression xsi:type="imgui:ButtonBuilder">
              <imgui:Name>MoveRight</imgui:Name>
              <imgui:Visible>true</imgui:Visible>
              <imgui:Text>Move Right</imgui:Text>
            </Expression>
            <Expression xsi:type="imgui:ButtonBuilder">
              <imgui:Name>BackLeft</imgui:Name>
              <imgui:Visible>true</imgui:Visible>
              <imgui:Text>Back Left</imgui:Text>
            </Expression>
            <Expression xsi:type="imgui:ButtonBuilder">
              <imgui:Name>BackRight</imgui:Name>
              <imgui:Visible>true</imgui:Visible>
