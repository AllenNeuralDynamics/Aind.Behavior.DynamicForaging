            </Expression>
            <Expression xsi:type="imgui:TextBuilder">
              <imgui:Visible>true</imgui:Visible>
              <imgui:Text>0.25mm</imgui:Text>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:CombineLatest" />
            </Expression>
