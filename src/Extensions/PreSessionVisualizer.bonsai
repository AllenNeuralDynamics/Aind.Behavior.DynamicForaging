              <imgui:Text>0.00mm</imgui:Text>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:CombineLatest" />
            </Expression>
            <Expression xsi:type="imgui:TableNextColumnBuilder">
