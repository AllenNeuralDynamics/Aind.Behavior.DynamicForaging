            <Expression xsi:type="imgui:TextBuilder">
              <imgui:Visible>true</imgui:Visible>
              <imgui:Text>y2: </imgui:Text>
            </Expression>
            <Expression xsi:type="imgui:TableNextColumnBuilder">
              <imgui:Visible>true</imgui:Visible>
            </Expression>
            <Expression xsi:type="imgui:TextBuilder">
