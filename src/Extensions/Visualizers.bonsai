              <p5:EventName>LickLeft</p5:EventName>
              <p5:Color>Red</p5:Color>
              <p5:YPosition>0.9</p5:YPosition>
              <p5:MarkerSize>6</p5:MarkerSize>
              <p5:Marker>Down</p5:Marker>
            </p5:PointPlotter>
            <p5:PointPlotter>
              <p5:EventName>LickRight</p5:EventName>
              <p5:Color>Blue</p5:Color>
              <p5:YPosition>0.1</p5:YPosition>
              <p5:MarkerSize>6</p5:MarkerSize>
              <p5:Marker>Up</p5:Marker>
            </p5:PointPlotter>
            <p5:PointPlotter>
              <p5:EventName>IsRightTriggerQuickRetract</p5:EventName>
              <p5:Color>DarkCyan</p5:Color>
              <p5:YPosition>0.5</p5:YPosition>
              <p5:MarkerSize>6</p5:MarkerSize>
              <p5:Marker>Plus</p5:Marker>
            </p5:PointPlotter>
            <p5:PointPlotter>
              <p5:EventName>DeliverSecondaryReinforcer</p5:EventName>
              <p5:Color>Sienna</p5:Color>
              <p5:YPosition>0.5</p5:YPosition>
              <p5:MarkerSize>6</p5:MarkerSize>
              <p5:Marker>Plus</p5:Marker>
            </p5:PointPlotter>
            <p5:PointPlotter>
              <p5:EventName>WaterRight</p5:EventName>
              <p5:Color>Red</p5:Color>
              <p5:YPosition>0.2</p5:YPosition>
              <p5:MarkerSize>6</p5:MarkerSize>
              <p5:Marker>Circle</p5:Marker>
            </p5:PointPlotter>
            <p5:PointPlotter>
              <p5:EventName>WaterLeft</p5:EventName>
              <p5:Color>Blue</p5:Color>
              <p5:YPosition>0.8</p5:YPosition>
              <p5:MarkerSize>6</p5:MarkerSize>
              <p5:Marker>Circle</p5:Marker>
            </p5:PointPlotter>
          </p5:PointPlotters>
        </Combinator>
      </Expression>
